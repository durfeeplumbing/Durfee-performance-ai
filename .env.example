# PostgreSQL connection. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true

# Supabase Auth. The publishable key is intended for application clients;
# never put a Supabase secret/service-role key in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Public application URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional server-only live road routing. Keep this private; do not prefix with NEXT_PUBLIC.
# When absent, route planning falls back to estimated geographic drive time.
MAPBOX_ACCESS_TOKEN=

# Optional server-only vendor invoice extraction. Never expose this key to the browser.
# GPT-5.6 Luna supports image input through the Responses API and is the cost-sensitive default.
OPENAI_API_KEY=
AI_INVOICE_MODEL=gpt-5.6-luna
